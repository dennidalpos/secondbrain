{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository directive proposal (one-shot analysis, DOC06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections", "coveredElsewhere", "warnings"],
  "properties": {
    "sections": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body", "rationale", "sources"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "rationale": { "type": "string", "maxLength": 600 },
          "sources": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 } }
        }
      }
    },
    "coveredElsewhere": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "where"],
        "properties": {
          "topic": { "type": "string", "maxLength": 200 },
          "where": { "type": "string", "enum": ["global", "common", "dossier", "agents-md"] }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 400 } }
  }
}
