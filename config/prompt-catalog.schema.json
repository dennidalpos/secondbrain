{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "categories", "prompts"],
  "$defs": {
    "line": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n\\t]+$"},
    "id": {"type": "string", "pattern": "^pmt-[0-9a-f]{8}$"}
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogVersion": {"const": 1},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "i18n"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "title": {"type": "string", "minLength": 1, "maxLength": 88, "pattern": "^[^\\r\\n\\t]+$"},
      "i18n": {"type": "object", "additionalProperties": false, "required": ["it"], "properties": {
        "it": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 88, "pattern": "^[^\\r\\n\\t]+$"}}}
      }}
    }}},
    "prompts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "code", "category", "summary", "target", "mode", "scope", "requires", "example", "file", "related", "i18n"], "properties": {
      "id": {"$ref": "#/$defs/id"},
      "code": {"type": "string", "pattern": "^[A-Z]{2,4}[0-9]{2}$"},
      "category": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
      "summary": {"type": "string", "minLength": 1, "maxLength": 82, "pattern": "^[^\\r\\n\\t]+$"},
      "target": {"enum": ["repository", "central"]},
      "mode": {"enum": ["read", "write", "verify"]},
      "destructive": {"type": "boolean"},
      "scope": {"type": "string", "pattern": "^(repo|area|file|central)(/(repo|area|file|central))*$"},
      "requires": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n\\t]+$"},
      "example": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n\\t]+$"},
      "file": {"type": "string", "pattern": "^[A-Z]{2,4}[0-9]{2}\\.md$"},
      "related": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "i18n": {"type": "object", "additionalProperties": false, "required": ["it"], "properties": {
        "it": {"type": "object", "additionalProperties": false, "required": ["summary", "requires", "example"], "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 82, "pattern": "^[^\\r\\n\\t]+$"},
          "requires": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n\\t]+$"},
          "example": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n\\t]+$"}
        }}
      }}
    }}}
  }
}
