{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "kind", "issuer", "domains", "jurisdictions", "language", "officialId", "edition", "publicationDate", "rights", "endpoints", "versions", "acceptedVersion", "relatedSources", "effectiveDates", "notes"],
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["regulation", "decision"]}}, "required": ["kind"]},
     "then": {"properties": {
       "jurisdictions": {"items": {"not": {"const": "Global"}}},
       "officialId": {"type": "string", "minLength": 1},
       "effectiveDates": {"minItems": 1}
     }}}
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["regulation", "decision", "guideline", "standard", "technical-documentation", "dataset", "dependency", "license", "runbook"]},
    "issuer": {"type": "string", "minLength": 1},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "language": {"type": "string", "minLength": 2},
    "officialId": {"type": ["string", "null"]},
    "edition": {"type": "string", "minLength": 1},
    "publicationDate": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rights": {"type": "object", "required": ["status", "reference", "notes"], "additionalProperties": false, "properties": {"status": {"enum": ["public-reusable", "reference-only"]}, "reference": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}},
    "endpoints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "url", "format", "role", "allowedHosts", "expectedText"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
      "url": {"type": "string", "pattern": "^https://"},
      "format": {"enum": ["html", "pdf", "docx", "text", "csv", "json"]},
      "fileName": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
      "layout": {"enum": ["single", "two-column"]},
      "role": {"enum": ["canonical", "original", "discovery"]},
      "allowedHosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"}},
      "expectedText": {"type": "string", "minLength": 1}
    }}},
    "versions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "reviewStatus"], "properties": {"id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"}, "reviewStatus": {"enum": ["candidate", "verified", "incomplete", "superseded", "rejected"]}}}},
    "acceptedVersion": {"type": ["string", "null"], "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"},
    "relatedSources": {"type": "array", "items": {"type": "object", "required": ["id", "relation"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "relation": {"enum": ["amends", "supersedes", "supplements", "interprets", "related"]}}}},
    "effectiveDates": {"type": "array", "items": {"type": "object", "required": ["provision", "date", "status", "reference"], "additionalProperties": false, "properties": {"provision": {"type": "string"}, "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "status": {"enum": ["verified", "requires-verification"]}, "reference": {"type": "string"}}}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "dataset": {"type": "object", "required": ["period", "geography", "units", "schema", "usage"], "properties": {"period": {"type": "string"}, "geography": {"type": "string"}, "units": {"type": "string"}, "schema": {"type": "string"}, "usage": {"type": "string"}}, "additionalProperties": false}
  }
}
