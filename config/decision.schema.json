{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "User decision records of one repository dossier (decisions.json), asset contracts section 5 (#588). Semantic rules (one recommended option listed first, supersedes targets, task links) are checked in scripts/SecondBrain.Decisions.psm1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "isoTime": { "type": "string", "minLength": 10 },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "recommended": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "question", "options", "context", "asked", "scope", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^dec-[0-9a-f]{8}$" },
        "kind": { "enum": ["choice", "confirm", "approval"] },
        "question": { "type": "string", "minLength": 1, "maxLength": 400 },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "taskId": { "type": "string" },
            "workflowRun": { "type": "string" },
            "step": { "type": "string" },
            "assets": { "type": "array", "items": { "type": "string" } },
            "evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "asked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "through", "by"],
          "properties": {
            "at": { "$ref": "#/$defs/isoTime" },
            "through": { "enum": ["structured-tool", "text-fallback"] },
            "by": { "type": "string", "minLength": 1 }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "at"],
          "properties": {
            "optionId": { "type": "string" },
            "text": { "type": "string", "minLength": 1 },
            "by": { "const": "user" },
            "at": { "$ref": "#/$defs/isoTime" }
          },
          "oneOf": [ { "required": ["optionId"] }, { "required": ["text"] } ]
        },
        "scope": { "enum": ["task", "durable"] },
        "status": { "enum": ["open", "answered", "withdrawn"] },
        "supersedes": { "type": "string", "pattern": "^dec-[0-9a-f]{8}$" },
        "withdrawn": {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "reason"],
          "properties": {
            "at": { "$ref": "#/$defs/isoTime" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "answered" } } }, "then": { "required": ["answer"] }, "else": { "not": { "required": ["answer"] } } },
        { "if": { "properties": { "status": { "const": "withdrawn" } } }, "then": { "required": ["withdrawn"] }, "else": { "not": { "required": ["withdrawn"] } } }
      ]
    }
  }
}
