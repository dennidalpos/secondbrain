{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["decision", "versionId", "fingerprint", "reason", "decidedBy", "decidedAt"], "properties": {
      "decision": {"enum": ["accept", "reject", "known-variant"]},
      "versionId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"},
      "fingerprint": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
      "previousAcceptedVersion": {"type": ["string", "null"]},
      "reason": {"type": "string", "minLength": 1},
      "decidedBy": {"type": "string", "minLength": 1},
      "decidedAt": {"type": "string", "minLength": 1}
    }}}
  }
}
